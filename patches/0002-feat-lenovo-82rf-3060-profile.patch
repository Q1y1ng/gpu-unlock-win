+#if defined(GU_PROFILE_LENOVO_82RF)
+/* Hybrid laptop topology (LENOVO 82RF: Intel iGPU + RTX 3060 Laptop).
+ *
+ * The observation capture (DIAG01.TXT, 2026-10-25) shows exactly two GOPs:
+ *   - one WITH a device path, whose PCI parent is not the target GPU (iGPU);
+ *   - one WITHOUT a device path, which is ConsoleOutHandle and reports no
+ *     framebuffer.
+ * No GOP resolves to the target GPU, and no nvgop DriverBinding exists, so the
+ * target owns no scanout. Releasing the target therefore cannot blank the
+ * console, which is the only property the upstream AMD-specific check needed.
+ *
+ * The check stays fail-closed: any GOP that resolves to the target device, a
+ * missing console GOP, more than one pathless GOP, or an enumeration larger
+ * than the upstream bound all reject the attempt.
+ */
+static BOOLEAN HybridGopIsTarget(EFI_DEVICE_PATH_PROTOCOL *Path) {
+  EFI_DEVICE_PATH_PROTOCOL *remaining=Path;EFI_HANDLE parent=NULL;
+  EFI_PCI_IO_PROTOCOL *pci=NULL;UINT32 id=0;
+  if(!Gu.bs->LocateDevicePath)return TRUE;              /* cannot prove -> treat as target */
+  EFI_STATUS status=Gu.bs->LocateDevicePath(&PciGuid,&remaining,&parent);
+  if(EFI_ERROR(status) || !parent)return TRUE;
+  status=Gu.bs->HandleProtocol(parent,&PciGuid,(VOID **)&pci);
+  if(EFI_ERROR(status) || !pci || !pci->Pci.Read)return TRUE;
+  status=pci->Pci.Read(pci,EfiPciIoWidthUint32,0,1,&id);
+  if(EFI_ERROR(status))return TRUE;
+  GuLog("hybrid GOP PCI parent id=%#x target=%#x\n",id,(unsigned)GU_BOARD_ID);
+  return id==GU_BOARD_ID;
+}
+static BOOLEAN DisplayCheck(VOID) {
+  EFI_HANDLE *handles=NULL;UINTN count=0,pathful=0,pathless=0;BOOLEAN valid=TRUE;
+  (void)GopInfoLog;(void)ConsoleGopCheck;   /* AMD-only helpers; keep -Werror quiet */
+  EFI_STATUS status=Gu.bs->LocateHandleBuffer(ByProtocol,&GopGuid,NULL,&count,&handles);
+  GuLog("hybrid GOP enumeration: status=%#llx handles=%zu\n",(unsigned long long)status,(size_t)count);
+  if(EFI_ERROR(status) || !handles || !count || count>16){if(handles)GuFree(handles);return FALSE;}
+  for(UINTN i=0;i<count;i++) {
+    EFI_GRAPHICS_OUTPUT_PROTOCOL *gop=NULL;EFI_DEVICE_PATH_PROTOCOL *path=NULL;
+    status=Gu.bs->HandleProtocol(handles[i],&GopGuid,(VOID **)&gop);
+    if(EFI_ERROR(status) || !gop) {
+      GuLog("hybrid GOP[%u] invalid protocol: status=%#llx\n",(unsigned)i,(unsigned long long)status);
+      valid=FALSE;break;
+    }
+    status=Gu.bs->HandleProtocol(handles[i],&PathGuid,(VOID **)&path);
+    if(EFI_ERROR(status) || !path) {
+      /* Pathless GOP: must be the system console and must not own a scanout. */
+      pathless++;
+      GuLog("hybrid GOP[%u] pathless console=%u framebuffer=%#llx bytes=%zu\n",(unsigned)i,
+        (unsigned)(handles[i]==Table->ConsoleOutHandle),
+        (unsigned long long)(gop->Mode?gop->Mode->FrameBufferBase:0),
+        (size_t)(gop->Mode?gop->Mode->FrameBufferSize:0));
+      if(handles[i]!=Table->ConsoleOutHandle || !gop->Mode || gop->Mode->FrameBufferBase) {
+        valid=FALSE;break;
+      }
+      continue;
+    }
+    if(HybridGopIsTarget(path)) {
+      GuLog("hybrid GOP[%u] belongs to the target GPU; release would blank it\n",(unsigned)i);
+      valid=FALSE;break;
+    }
+    pathful++;
+  }
+  if(handles)GuFree(handles);
+  GuLog("hybrid GOP result: valid=%u pathful=%zu pathless=%zu\n",valid,pathful,pathless);
+  return valid && pathful>=1 && pathless==1 && GuLogReady();
+}
