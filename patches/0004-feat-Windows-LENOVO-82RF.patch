+#if defined(GU_PROFILE_LENOVO_82RF)
+/* Hybrid-capable laptop topology (LENOVO 82RF: Intel Iris Xe iGPU + RTX 3060
+ * Laptop). This machine has a MUX, so the firmware display owner depends on
+ * the selected graphics mode:
+ *
+ *   Hybrid (iGPU drives the panel): the physical GOP is the iGPU's and the
+ *   target GPU owns no scanout -> releasing the target cannot blank anything.
+ *   Discrete (dGPU drives the panel): nvidia-smi reports display_active=Enabled
+ *   and the physical GOP resolves to the target GPU -> an FLR would blank the
+ *   console, so the attempt must be refused.
+ *
+ * The 2026-10-25 run proved the second case (PCI parent id 0x256010de) while
+ * the machine was in discrete-only mode, so the rule below is stated on the
+ * property that actually matters rather than on which GPU happens to be first:
+ * the target GPU must not be scanning out, and the console must not be served
+ * by the target GPU. Every GOP is logged before the decision, so a refusal
+ * still leaves a complete topology record in REPORT.TXT. */
+static BOOLEAN HybridGopParentId(EFI_DEVICE_PATH_PROTOCOL *Path,UINT32 *Id) {
+  EFI_DEVICE_PATH_PROTOCOL *remaining=Path;EFI_HANDLE parent=NULL;
+  EFI_PCI_IO_PROTOCOL *pci=NULL;UINT32 id=0;
+  if(!Gu.bs->LocateDevicePath)return FALSE;
+  EFI_STATUS status=Gu.bs->LocateDevicePath(&PciGuid,&remaining,&parent);
+  if(EFI_ERROR(status) || !parent)return FALSE;
+  status=Gu.bs->HandleProtocol(parent,&PciGuid,(VOID **)&pci);
+  if(EFI_ERROR(status) || !pci || !pci->Pci.Read)return FALSE;
+  status=pci->Pci.Read(pci,EfiPciIoWidthUint32,0,1,&id);
+  if(EFI_ERROR(status))return FALSE;
+  *Id=id;return TRUE;
+}
+static BOOLEAN HybridDisplayCheck(VOID) {
+  EFI_HANDLE *handles=NULL;UINTN count=0,pathful=0,pathless=0,console_gops=0,target_scanout=0;
+  BOOLEAN bad=FALSE,console_target=FALSE;
+  (void)GopInfoLog;(void)ConsoleGopCheck;   /* AMD-only helpers; keep -Werror quiet */
+  EFI_STATUS status=Gu.bs->LocateHandleBuffer(ByProtocol,&GopGuid,NULL,&count,&handles);
+  GuLog("hybrid GOP enumeration: status=%#llx handles=%zu target_console_allowed=%u\n",
+    (unsigned long long)status,(size_t)count,
+#if defined(GU_ALLOW_TARGET_CONSOLE)
+  1U
+#else
+  0U
+#endif
+  );
+#if defined(GU_ALLOW_TARGET_CONSOLE)
+  /* Discrete-graphics mode: the panel is driven by the target GPU itself, so the
+   * premise of this check does not hold. Record the topology and continue; the
+   * console is expected to be lost the moment its driver is released. */
+  if(EFI_ERROR(status) || count>16){if(handles)GuFree(handles);return FALSE;}
+  if(!handles || !count) {
+    GuLog("hybrid GOP: no GOP presents a display; accepting because target-console mode is explicit\n");
+    return GuLogReady();
+  }
+#else
+  if(EFI_ERROR(status) || !handles || !count || count>16){if(handles)GuFree(handles);return FALSE;}
+#endif
+  for(UINTN i=0;i<count;i++) {
+    EFI_GRAPHICS_OUTPUT_PROTOCOL *gop=NULL;EFI_DEVICE_PATH_PROTOCOL *path=NULL;
+    status=Gu.bs->HandleProtocol(handles[i],&GopGuid,(VOID **)&gop);
+    BOOLEAN is_console=(handles[i]==Table->ConsoleOutHandle);
+    if(EFI_ERROR(status) || !gop) {
+      /* Still classify the handle so the record stays complete. */
+      if(!path)pathless++;if(is_console)console_gops++;
+      GuLog("hybrid GOP[%u] invalid protocol: status=%#llx console=%u\n",(unsigned)i,
+        (unsigned long long)status,(unsigned)is_console);
+      bad=TRUE;continue;
+    }
+    UINT64 fb=gop->Mode?gop->Mode->FrameBufferBase:0;
+    UINTN  fbsize=gop->Mode?gop->Mode->FrameBufferSize:0;
+    status=Gu.bs->HandleProtocol(handles[i],&PathGuid,(VOID **)&path);
+    BOOLEAN has_path=!EFI_ERROR(status) && path;
+    UINT32 id=0;BOOLEAN resolved=FALSE,owned=FALSE;
+    if(has_path) {
+      pathful++;
+      resolved=HybridGopParentId(path,&id);
+      /* A pathful GOP we cannot attribute is treated as target-owned. */
+      owned=resolved?(id==GU_BOARD_ID):TRUE;
+    } else {
+      pathless++;
+    }
+    GuLog("hybrid GOP[%u] path=%u pci_id=%#x resolved=%u target=%u console=%u framebuffer=%#llx bytes=%zu\n",
+      (unsigned)i,(unsigned)has_path,id,(unsigned)resolved,(unsigned)owned,(unsigned)is_console,
+      (unsigned long long)fb,(size_t)fbsize);
+    if(is_console)console_gops++;
+    if(owned && fb)target_scanout++;
+    if(owned && is_console)console_target=TRUE;
+    if(!has_path && !is_console)bad=TRUE;   /* a pathless GOP must be the console's */
+  }
+  if(handles)GuFree(handles);
+  GuLog("hybrid GOP result: pathful=%zu pathless=%zu console=%zu target_scanout=%zu console_target=%u bad=%u\n",
+    pathful,pathless,console_gops,target_scanout,(unsigned)console_target,(unsigned)bad);
+#if defined(GU_ALLOW_TARGET_CONSOLE)
+  if(console_target || target_scanout)
+    GuLog("hybrid GOP: TARGET-CONSOLE MODE - the GPU that is about to be reset owns the panel.\n"
+          "Expect the screen to go dark; every step is still written to REPORT.TXT.\n");
+  return GuLogReady();
+#else
+  if(console_target)GuLog("hybrid GOP refuses: the console is served by the target GPU; select Hybrid graphics mode\n");
+  else if(target_scanout)GuLog("hybrid GOP refuses: the target GPU is scanning out %zu framebuffer(s); select Hybrid graphics mode\n",target_scanout);
+  return !bad && !console_target && target_scanout==0 && console_gops>=1 && pathful>=1 && GuLogReady();
+#endif
+}
+#endif /* GU_PROFILE_LENOVO_82RF */
 #endif
 static BOOLEAN DisplayCheck(VOID) {
 #ifdef GU_HEADLESS_RESEARCH
   return GuHeadlessCheck() && GuLogReady();
+#elif defined(GU_PROFILE_LENOVO_82RF)
+  return HybridDisplayCheck();
 #else
   EFI_HANDLE *handles=NULL;UINTN count=0,intel=0;BOOLEAN valid=TRUE;
   EFI_GRAPHICS_OUTPUT_MODE_INFORMATION physical={0},forwarded={0};BOOLEAN forwarding=FALSE;
@@ -412,6 +521,70 @@ static VOID ReleaseHalt(EFI_STATUS Status,BOOLEAN Attempted) {
     (unsigned long long)Status,Stage,Attempted,(unsigned long long)contained,(unsigned)(Gu.pci!=NULL));
