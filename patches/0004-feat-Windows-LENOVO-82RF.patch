 }
+#if defined(GU_HANDOFF_WINDOWS)
+/* Load and start the real Windows Boot Manager from the Windows ESP.
+ *
+ * The ESP is identified by the GPT partition GUID recorded in
+ * boot/platform-config.h (never by drive letter or by "the only ESP on the
+ * machine"), so this cannot wander onto the dedicated unlock partition or any
+ * other volume. The firmware-provided device path of that volume has its
+ * END_ENTIRE node replaced by a FILEPATH node, which is what LoadImage needs.
+ * This runs only after a successful transaction and after every resource of
+ * this application has been released. */
+static EFI_STATUS HandoffWindows(VOID) {
+  static EFI_GUID PathGuid=EFI_DEVICE_PATH_PROTOCOL_GUID,FsGuid=EFI_SIMPLE_FILE_SYSTEM_PROTOCOL_GUID;
+  static const CHAR16 Name[]=L"\\EFI\\Microsoft\\Boot\\bootmgfw.efi";
+  EFI_HANDLE *handles=NULL;UINTN count=0,esp_count=0;EFI_HANDLE esp=NULL;
+  EFI_STATUS status=Gu.bs->LocateHandleBuffer(ByProtocol,&FsGuid,NULL,&count,&handles);
+  if(EFI_ERROR(status) || !handles || !count || count>64){if(handles)GuFree(handles);
+    GuLog("handoff: no filesystems\n");return EFI_NOT_FOUND;}
+  for(UINTN i=0;i<count;i++) {
+    EFI_DEVICE_PATH_PROTOCOL *dp=NULL;
+    if(EFI_ERROR(Gu.bs->HandleProtocol(handles[i],&PathGuid,(VOID **)&dp)) || !dp)continue;
+    if(GuPathIsPartition(dp,&GuWindowsPartition)){esp=handles[i];esp_count++;}
+  }
+  GuFree(handles);
+  GuLog("handoff: windows ESP matches=%zu\n",esp_count);
+  if(esp_count!=1 || !esp){GuLog("handoff: refusing, expected exactly one Windows ESP\n");return EFI_NOT_FOUND;}
+  EFI_DEVICE_PATH_PROTOCOL *base=NULL;
+  status=Gu.bs->HandleProtocol(esp,&PathGuid,(VOID **)&base);
+  if(EFI_ERROR(status) || !base)return status;
+  /* Locate the END_ENTIRE node of the volume path. */
+  UINTN prefix=0;const EFI_DEVICE_PATH_PROTOCOL *node=base;
+  for(UINTN n=0;n<64;n++) {
+    UINTN len=node->Length[0]+((UINTN)node->Length[1]<<8);
+    if(len<4)return EFI_DEVICE_ERROR;
+    if(node->Type==END_DEVICE_PATH_TYPE && node->SubType==END_ENTIRE_DEVICE_PATH_SUBTYPE) {
+      prefix=(UINTN)((const UINT8 *)node-(const UINT8 *)base);break;
+    }
+    node=(const VOID *)((const UINT8 *)node+len);
+  }
+  if(!prefix){GuLog("handoff: volume path has no end node\n");return EFI_DEVICE_ERROR;}
+  UINTN nameBytes=sizeof(Name);                        /* includes the terminator */
+  UINTN fileSize=(4U+nameBytes+3U)&~(UINTN)3U;
+  UINTN total=prefix+fileSize+4U;
+  EFI_DEVICE_PATH_PROTOCOL *full=GuAlloc(total);
+  if(!full)return EFI_OUT_OF_RESOURCES;
+  memcpy(full,base,prefix);
+  FILEPATH_DEVICE_PATH *file=(FILEPATH_DEVICE_PATH *)((UINT8 *)full+prefix);
+  file->Header.Type=MEDIA_DEVICE_PATH;file->Header.SubType=MEDIA_FILEPATH_DP;
+  file->Header.Length[0]=(UINT8)(fileSize&0xff);file->Header.Length[1]=(UINT8)(fileSize>>8);
+  memset(file->PathName,0,fileSize-4);
+  memcpy(file->PathName,Name,nameBytes);
+  EFI_DEVICE_PATH_PROTOCOL *end=(EFI_DEVICE_PATH_PROTOCOL *)((UINT8 *)full+prefix+fileSize);
+  end->Type=END_DEVICE_PATH_TYPE;end->SubType=END_ENTIRE_DEVICE_PATH_SUBTYPE;
+  end->Length[0]=4;end->Length[1]=0;
+  EFI_HANDLE child=NULL;UINTN exitDataSize=0;CHAR16 *exitData=NULL;
+  status=Gu.bs->LoadImage(FALSE,Gu.image,full,NULL,0,&child);
+  GuFree(full);
+  GuLog("handoff: LoadImage status=%#llx image=%#llx\n",(unsigned long long)status,(unsigned long long)(UINTN)child);
+  if(EFI_ERROR(status))return status;
+  status=Gu.bs->StartImage(child,&exitDataSize,&exitData);
+  GuLog("handoff: StartImage returned status=%#llx exit_data=%zu\n",(unsigned long long)status,(size_t)exitDataSize);
+  if(exitData)GuFree(exitData);
+  return status;
+}
+#endif
 EFI_STATUS EFIAPI efi_main(EFI_HANDLE Image,EFI_SYSTEM_TABLE *St) {
   if(!St || !St->BootServices || !St->RuntimeServices)return EFI_INVALID_PARAMETER;
   Table=St;GuInit(St->BootServices,NULL);Gu.image=Image;Gu.display_check=DisplayCheck;
@@ -528,5 +701,19 @@ EFI_STATUS EFIAPI efi_main(EFI_HANDLE Image,EFI_SYSTEM_TABLE *St) {
   GuReleaseAssets();
   if(!EFI_ERROR(status))GuConsole("UEFI transaction completed and cleaned up. Returning to firmware; Windows validation is pending.\n");
   else GuConsole("Attempt cancelled or rejected. Returning without another attempt.\n");
+#if defined(GU_HANDOFF_WINDOWS)
+  /* Hand the completed transaction straight to the real Windows Boot Manager.
+   * Returning to firmware is NOT safe in this topology: the firmware boot
+   * manager may try to redraw its menu through the display driver we just
+   * disconnected, and the machine then hangs on a black screen with the unlock
+   * already applied but never used. Loading bootmgfw.efi ourselves skips that.
+   * Only a successful transaction is handed off; every failure path still
+   * returns to firmware so the operator sees the decision. */
+  if(!EFI_ERROR(status)) {
+    EFI_STATUS handoff=HandoffWindows();
+    GuLog("windows handoff: status=%#llx\n",(unsigned long long)handoff);
+    if(EFI_ERROR(handoff))status=handoff;
+  }
+#endif
   return status;
 }
